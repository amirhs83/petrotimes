  "stylesheets": [],
  "inlineStyles": [
    "\n            * { box-sizing: border-box; }\n            body { font-family: Arial, sans-serif; margin: 0; padding: 0; }\n    \n            .ticker-container {\n                width: 100%;\n                overflow: hidden;\n                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\n                background: #fff;\n                white-space: nowrap;\n                position: relative;\n            }\n    \n            .ticker-slider {\n                display: inline-flex;\n                white-space: nowrap;\n                cursor: grab;\n                transition: transform 0.1s linear;\n            }\n    \n            .ticker-item {\n                display: flex;\n                align-items: center;\n                padding: 10px 20px;\n                border-right: 1px solid #ddd;\n                min-width: 200px;\n                transition: background-color 0.5s ease;\n            }\n    \n            .ticker-item img {\n                width: 20px; \n                height: 20px; \n                margin-right: 10px;\n                border-radius: 50%;\n                border: 1px solid #e3e3e3;\n            }\n    \n            .market-name { font-weight: bold; margin-right: 10px; }\n            .market-value { margin-right: 10px; transition: color 0.5s ease-in-out; }\n            .market-change { font-weight: bold; transition: color 0.5s ease-in-out; }\n            .market-change.positive { color: green; }\n            .market-change.negative { color: red; }\n    \n            /* Loading placeholder */\n            .loading { color: #ccc; animation: pulse 1s infinite ease-in-out; }\n            @keyframes pulse {\n                0% { color: #ccc; }\n                50% { color: #bbb; }\n                100% { color: #ccc; }\n            }\n    \n            /* Price update animation */\n            .updated-price {\n                animation: glow 1s ease-in-out;\n            }\n            @keyframes glow {\n                0% { background-color: #fa9000; }\n                100% { background-color: transparent; }\n            }\n    \n            /* Pause on hover */\n            .ticker-container:hover .ticker-slider { animation-play-state: paused; }\n        "
  ],
