# ============================================================
# Petro Times — environment configuration
# Copy to .env and adjust. Never commit the real .env.
# ============================================================

# --- Data source (backend connection) -----------------------
# snapshot : fixed content snapshot captured from petrotimes.ir
#            (deterministic — used by the visual regression suite)
# live     : WordPress REST API (wp-json/wp/v2) of WP_BASE_URL
WP_MODE=snapshot

# WordPress backend base URL (required when WP_MODE=live).
# The homepage is assembled from /wp-json/wp/v2/posts + /categories;
# chrome data (ticker, social, newsletter text, about, offcanvas) is
# reused from the snapshot. If the API is unreachable the app falls
# back to the snapshot automatically.
WP_BASE_URL=https://petrotimes.ir

# --- Database (Prisma / SQLite) -----------------------------
DATABASE_URL=file:/home/z/my-project/db/custom.db

# --- Optional: newsletter (Contact Form 7) ------------------
# When WP_BASE_URL is set, POST /api/newsletter proxies submissions
# to the WordPress CF7 endpoint. Without it the endpoint returns 501.
