# ============================================================
# Petro Times — environment configuration
# Copy to .env and adjust. Never commit the real .env.
# ============================================================

# --- Data source (backend connection) -----------------------
# snapshot : fixed content snapshot bundled with the app
#            (deterministic — used by the visual regression suite)
# remote   : fetch the assembled homepage JSON from the external
#            content backend at CONTENT_API_BASE_URL. The backend can be
#            written in ANY language — only the HTTP contract matters,
#            see docs/API-CONTRACT.md.
CONTENT_API_MODE=snapshot

# Base URL of the external content backend (required when
# CONTENT_API_MODE=remote). The frontend calls:
#   GET {CONTENT_API_BASE_URL}/homepage        → HomepageData JSON
#   POST {CONTENT_API_BASE_URL}/newsletter     ← { "email": "..." }
# If the backend is unreachable or returns an invalid payload the app
# falls back to the bundled snapshot automatically (never a blank page).
CONTENT_API_BASE_URL=

# Optional static bearer token sent with every upstream request as
# "Authorization: Bearer <CONTENT_API_TOKEN>".
CONTENT_API_TOKEN=

# Optional upstream timeout in milliseconds (default 8000).
#CONTENT_API_TIMEOUT_MS=8000

# Optional explicit URL for the newsletter upstream. When unset, the
# newsletter proxy uses CONTENT_API_BASE_URL + /newsletter.
#NEWSLETTER_API_URL=

# --- Database (Prisma / SQLite) -----------------------------
DATABASE_URL=file:/home/z/my-project/db/custom.db
